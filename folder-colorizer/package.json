{
  "name": "folder-colorizer",
  "displayName": "Folder Colorizer",
  "description": "Colorize workspace folders dynamically",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "folder-colorizer.setColor",
        "title": "AAA-Test Colora Cartella"
      }
    ],
    "keybindings": [
      {
        "command": "folder-colorizer.setColor",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c"
      }
    ],
    "iconThemes": [
      {
        "id": "school-folder-theme",
        "label": "Old School Folder Theme",
        "path": "./themes/school-folder-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.136.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
